# Runtime environment
APP_ENV=development

# POS simulator PostgreSQL
POS_DB_HOST=localhost
POS_DB_PORT=5432
POS_DB_NAME=mchange_me
POS_DB_USER=change_me
POS_DB_PASSWORD=change_me

# POS Generator
POS_SEED=42
POS_MODE=dev
POS_DEV_SALES_PER_COUNTRY=100
POS_FULL_SALES_PER_COUNTRY=400000
POS_PRICE_DEFECT_RATE=0.005
POS_SKU_DEFECT_RATE=0.01
POS_START_DATE=2026-01-01
POS_END_DATE=2026-12-31

# Shared seeded catalog (F2/F3/F4 ID space)
MASTER_SEED=42
CATALOG_PER_CATEGORY=15
CATALOG_ACTIVE_RATE=0.95

# Marketplace events (F4)
F4_DUPLICATE_RATE=0.0
F4_OOO_ENABLED=false
F4_OOO_MAX_LAG_SEC=21600

# F3 - Seller Inventory Simulator API (original implementation)
ERROR_RATE=0.03
ENABLE_NEGATIVE_INVENTORY=true

INVENTORY_API_URL=http://127.0.0.1:8001
INVENTORY_API_TOKEN=token-seller-123
INVENTORY_SELLER_ID=SELLER_001