# Runtime environment
APP_ENV=development

# POS simulator PostgreSQL
POS_DB_HOST=localhost
POS_DB_PORT=5432
POS_DB_NAME=mchange_me
POS_DB_USER=change_me
POS_DB_PASSWORD=change_me

# POS Generator
POS_SEED=42
POS_MODE=dev
POS_DEV_SALES_PER_COUNTRY=100
POS_FULL_SALES_PER_COUNTRY=400000
POS_PRICE_DEFECT_RATE=0.005
POS_SKU_DEFECT_RATE=0.01
POS_START_DATE=2026-01-01
POS_END_DATE=2026-12-31
